{
  "name": "@webf/rule",
  "version": "1.2.0",
  "description": "Business rule validation library",
  "keywords": [
    "rule",
    "validation",
    "business"
  ],
  "author": {
    "name": "Harshal Patil"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webf-run/rule.git"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check:types": "tsc -p tsconfig.json",
    "dev:format": "prettier --write .",
    "test": "node --test src/*.test.ts"
  },
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "prettier": "^3.4.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
